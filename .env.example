# Shared Discord bot token (never commit your real .env file)
DISCORD_TOKEN=

# Owner allowed to manage bot-wide command synchronization
OWNER_ID=0

# Register slash commands at startup only when explicitly enabled.
# Set true for one startup after changing commands, then set false again.
SYNC_ON_STARTUP=false

# --------------------------------------------------
# SERVER 1: TomoBao Server
# --------------------------------------------------
TOMOBAO_GUILD_ID=
TOMOBAO_APPLICATION_LOG_CHANNEL_ID=
TOMOBAO_DEVELOPER_ROLE_ID=
TOMOBAO_ALPHA_TESTER_ROLE_ID=
TOMOBAO_STAFF_ROLE_ID=

# --------------------------------------------------
# SERVER 2: Friend's Server
# Vietnamese Admin Application is intended for this server only.
# --------------------------------------------------
FRIEND_GUILD_ID=
FRIEND_APPLICATION_LOG_CHANNEL_ID=
FRIEND_ADMIN_ROLE_ID=
FRIEND_STAFF_ROLE_ID=

# Optional database path
DATABASE_PATH=applications.db
